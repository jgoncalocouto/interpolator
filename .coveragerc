[run]
branch = True
relative_files = True
source =
    main
    interpolation
    coffee_widget
    column_picker
    excel_formulas
    tips

[report]
show_missing = True
skip_empty = True
precision = 1
fail_under = 90
exclude_also =
    if __name__ == ["']__main__["']:

[html]
directory = htmlcov
